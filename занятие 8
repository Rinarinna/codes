import pandas as pd
import numpy as np
import seaborn as sns

class Vacancies():
  def load(self,text):
    import requests
    from pandas import DataFrame as df
    from pandas import json_normalize

    host='http://api.hh.ru/vacancies?per_page=100&search_field=name&only_with_salary=True'
    tmp=df()
    cols=['id','name','area','salary','schedule']
    for i in range(2):
      url=host+'&text={0}&page={1}'.format(text,str(i))
      js=requests.get(url).json()['items']
      if len(js)!=0:
        tmp=tmp.append(df(js)[cols])
      else:
        break
    tmp=tmp.join(json_normalize(tmp.salary), how='inner')
    tmp['area']=json_normalize(tmp.area)[['name']]
    tmp['schedule']=json_normalize(tmp.schedule)[['name']]
    tmp.drop(columns=['salary'],inplace=True)
    self.df=tmp


Создать метод с изображением тепловой карты средней зарплаты по валюте и графику работы

salary_heatmap()

class Vacancies(Vacancies):
  def salary_heatmap(self):
    import seaborn as sns
    tmp=self.df.groupby(['schedule','currency'])['from'].mean().reset_index()
    tmp=tmp.pivot(index='currency', columns='schedule', values='from').fillna(0)
    sns.heatmap(tmp)

vac=Vacancies()
vac.load('Аналитик')
vac.salary_heatmap()


def av_salary(x):
  if x[2] is not None and x[3] is not None:
    return (x[2]+x[3])/2
  elif x[2] is not None:
    return x[2]
  else: return x[3]

counterM = 0
counterSP = 0
salM=0
salSP=0
for el in vac:
  if ('python' in el[1].lower()) and (el[7] == 'Москва'):
    if (av_salary(el) is not None):
      salM+=av_salary(el)
      counterM+=1
  elif ('python' in el[1].lower()) and (el[7] == 'Санкт-Петербург'):
    if (av_salary(el) is not None):
      salSP+=av_salary(el)
      counterSP+=1

salM=salM/counterM
salSP=salSP/counterSP

print('Moscow',round(salM) )
print('Piter', round(salSP))


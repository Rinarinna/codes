выкинуть из df salary, schedule.id, area.id и area.url

def explode(x):
  values=(sum([list(y.values()) if type(y)==dict else [y] for y in x],[]))

  index=sum([list(map(lambda z:y+'.'+z, list(x[y].keys()))) if type(x[y])==dict else [y] for y in x.index],[])

  return pd.Series(values,index=index)


df1=df.apply(explode, axis=1)

df1.drop(columns=['salary','schedule.id','area.id', 'area.url'],inplace=True)


Создать DataFrame df из 3х запросов к api.hh

'РазработчикANDPython', 'РазработчикANDC++', 'РазработчикANDGo'
параметр запросов: search_field=name
по каждому запросу нужно получить максимальное количество вакансий (range 20)
в конечном dataframe колонки должны быть поля ['id','name','area','salary', 'snippet', 'schedule']
в конечном dataframe индекс должен состояить из натуральных чисел (неповторяющихся)
'https://api.hh.ru/vacancies?text={0}&per_page=100&search_field=name&page={1}'

host = 'https://api.hh.ru/vacancies?text={0}&per_page=100&search_field=name&page={1}'
topics =['РазработчикANDPython', 'РазработчикANDC++', 'РазработчикANDGo']

df = pd.DataFrame()

import requests

for top in topics:
  for i in range(20):
    url = host.format(top,str(i))
    try:
      js=requests.get(url).json()['items']
      tmp=pd.DataFrame(js)[['id','name','area','salary','snippet','schedule']]
      df=df.append(tmp)
    except:
      break
df.index=range(df.shape[0])

